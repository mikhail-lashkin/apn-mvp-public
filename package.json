{
  "name": "apn-mvp-public",
  "version": "0.1.0-alpha",
  "description": "AI Poker Notes — public alpha (mobile + FastAPI)",
  "private": true,
  "scripts": {
    "dev": "cd apps/mobile && npm start",
    "dev:mobile": "cd apps/mobile && npm start",
    "dev:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-android.ps1",
    "dev:android:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-android.ps1 -MaestroSmoke",
    "build:release:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release-apk.ps1",
    "build": "cd apps/mobile && npm run build",
    "build:mobile": "cd apps/mobile && npm run build",
    "test": "cd apps/mobile && npm run test",
    "test:mobile": "cd apps/mobile && npm run test",
    "install:all": "npm install && cd apps/mobile && npm install",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:ps": "docker compose ps",
    "docker:logs": "docker compose logs -f backend",
    "docker:rebuild": "docker compose up -d --build backend",
    "e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/maestro-test.ps1 .maestro",
    "e2e:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/maestro-test.ps1 .maestro/smoke.yaml"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.12"
  }
}
