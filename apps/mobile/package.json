{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client --localhost",
    "start:dev-client:clear": "expo start --dev-client --localhost --clear",
    "android": "expo start --android --localhost",
    "android:device": "expo run:android --device",
    "android:clear": "expo start --android --clear --localhost",
    "android:tunnel": "expo start --android --tunnel",
    "android:tunnel:clear": "expo start --android --tunnel --clear",
    "android:port": "expo start --android --localhost --port 8083",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "tunnel": "expo start --tunnel",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/netinfo": "^11.3.1",
    "@react-navigation/native": "^7.1.18",
    "@react-navigation/stack": "^7.5.0",
    "expo": "~54.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-haptics": "^15.0.7",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "^8.0.8",
    "expo-router": "^6.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": "^4.1.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/plugin-transform-react-jsx": "^7.27.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.3",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react-native-worklets": "^0.6.1",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
